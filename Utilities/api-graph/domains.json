{
  "_comment": [
    "Loose domain groupings by task, after the chapters of Stevens and Rago's",
    "Advanced Programming in the UNIX Environment (3rd edition; `apue` is the",
    "chapter), plus the C library and Darwin's own. Hand-kept: each domain lists",
    "C function families or C names, as shell globs, and a declaration is in a",
    "domain when one of the C names it wraps, or that name's family, matches.",
    "The domains suggest related API the graph doesn't link (a pitch bundle's",
    "Related API section, `graphq.py domain`); nothing else depends on them.",
    "A family can be in several domains. Families no domain names are listed",
    "in GRAPH.md, so the file can be kept up as System grows."
  ],
  "domains": [
    {"id": "file-io", "title": "File I/O", "apue": "3",
     "match": ["open", "openat", "close", "close_range", "closefrom", "read", "write", "pread", "pwrite", "preadv", "pwritev", "lseek", "dup", "dup2", "dup3", "fcntl", "F_*", "O_*", "ioctl", "sync", "fsync", "fdatasync", "posix_fadvise", "POSIX_FADV_*", "posix_fallocate", "sendfile", "SEEK_*"]},
    {"id": "files-and-directories", "title": "Files and directories", "apue": "4",
     "match": ["stat", "fstat", "lstat", "fstatat", "access", "faccessat", "chmod", "chown", "chflags", "umask", "truncate", "ftruncate", "link", "linkat", "unlinkat", "symlink", "readlink", "rename", "renamex_np", "renameatx_np", "RENAME_*", "mkdir", "rmdir", "remove", "chdir", "getcwd", "chroot", "utimensat", "futimens", "UTIME_*", "opendir", "readdir", "closedir", "rewinddir", "fdopendir", "dirfd", "DT_*", "realpath", "mkfifo", "pathconf", "_PC_*", "statfs", "getfsstat", "MNT_*", "quotactl", "getxattr", "setxattr", "listxattr", "removexattr", "XATTR_*", "getattrlist", "getattrlistbulk", "copyfile", "COPYFILE_*", "fclonefileat", "clonefile", "removefile*", "REMOVEFILE_*", "mkdtemp", "mkostemp*", "mktemp", "mkpath_np", "mkpathat_np", "AT_*", "S_I*"]},
    {"id": "standard-io", "title": "Standard I/O", "apue": "5",
     "match": ["fopen", "fclose", "fread", "fwrite", "fflush", "fputs", "fputc", "putc", "fileno", "fdopen", "feof", "ferror", "clearerr", "setvbuf", "_IO*", "flockfile", "funlockfile", "ftrylockfile", "FILE", "stdin", "stdout", "stderr", "EOF"]},
    {"id": "system-data", "title": "System data files and information", "apue": "6",
     "match": ["getpwnam_r", "getpwuid_r", "passwd", "getgrgid_r", "getgrnam_r", "group", "getgrouplist", "initgroups", "uname", "utsname", "gethostname", "getlogin_r", "sysconf", "_SC_*", "confstr", "_CS_*", "sysctl", "sysctlbyname", "sysctlnametomib", "CTL_*", "KERN_*", "HW_*"]},
    {"id": "process-environment", "title": "Process environment", "apue": "7",
     "match": ["exit", "_exit", "atexit", "EXIT_*", "getenv", "setenv", "unsetenv", "secure_getenv", "_NSGetEnviron", "_NSGetExecutablePath", "environ", "getrlimit", "setrlimit", "RLIMIT_*", "rlimit"]},
    {"id": "process-control", "title": "Process control", "apue": "8",
     "match": ["fork", "posix_spawn*", "POSIX_SPAWN_*", "execve", "execvp", "waitpid", "waitid", "wait4", "P_ALL", "P_PID", "P_PGID", "getpid", "getppid", "pid_t", "getuid", "geteuid", "getgid", "getegid", "setuid", "seteuid", "setgid", "setegid", "setreuid", "setregid", "getgroups", "setgroups", "issetugid", "getpriority", "setpriority", "PRIO_*", "nice", "proc_*", "PROC_*", "pidfd_open", "rusage", "WNOHANG", "WUNTRACED", "WCONTINUED", "WEXITED", "WSTOPPED", "WNOWAIT", "WIF*", "WEXITSTATUS", "WTERMSIG", "WSTOPSIG"]},
    {"id": "process-relationships", "title": "Process relationships", "apue": "9",
     "match": ["setsid", "getsid", "setpgid", "getpgid", "getpgrp", "tcgetpgrp", "tcsetpgrp", "tcgetsid", "killpg"]},
    {"id": "signals", "title": "Signals", "apue": "10",
     "match": ["sigaction", "sig*", "SIG*", "SA_*", "kill", "killpg", "raise", "alarm", "pthread_kill", "pthread_sigmask", "signalfd", "pidfd_send_signal", "strsignal"]},
    {"id": "threads", "title": "Threads and thread control", "apue": "11-12",
     "match": ["pthread_*", "PTHREAD_*", "sched_*", "SCHED_*", "qos_class_*", "QOS_CLASS_*", "os_unfair_lock_*", "cpu_set_t", "CPU_*"]},
    {"id": "advanced-io", "title": "Advanced I/O: events, memory-mapped I/O, locks", "apue": "14",
     "match": ["poll", "POLL*", "kqueue", "kevent", "EV_*", "EVFILT_*", "NOTE_*", "epoll_*", "EPOLL*", "eventfd", "EFD_*", "timerfd_*", "TFD_*", "mmap", "munmap", "mprotect", "msync", "madvise", "MADV_*", "mlock", "mlockall", "munlock", "munlockall", "MCL_*", "mincore", "MAP_*", "PROT_*", "MS_*", "flock", "LOCK_*", "readv", "writev", "iovec"]},
    {"id": "ipc", "title": "Interprocess communication", "apue": "15",
     "match": ["pipe", "pipe2", "mkfifo", "shm_open", "shm_unlink", "sem_*", "SEM_*", "socketpair"]},
    {"id": "sockets", "title": "Network IPC: sockets", "apue": "16-17",
     "match": ["socket", "bind", "listen", "accept", "accept4", "connect", "send", "sendto", "sendmsg", "sendmmsg", "recv", "recvfrom", "recvmsg", "recvmmsg", "shutdown", "SHUT_*", "getsockopt", "setsockopt", "SO_*", "SOL_*", "IP_*", "IPV6_*", "IPPROTO_*", "TCP_*", "MSG_*", "getsockname", "getpeername", "getaddrinfo", "freeaddrinfo", "getnameinfo", "addrinfo", "AI_*", "NI_*", "EAI_*", "inet_pton", "inet_ntop", "if_nametoindex", "if_indextoname", "getifaddrs", "sockaddr*", "AF_*", "PF_*", "SOCK_*", "cmsghdr", "msghdr", "CMSG_*", "in_addr", "in6_addr", "IPTOS_*"]},
    {"id": "terminal-io", "title": "Terminal I/O", "apue": "18",
     "match": ["tcgetattr", "tcsetattr", "tcdrain", "tcflow", "tcflush", "tcsendbreak", "cfmakeraw", "cf*speed", "termios", "B[0-9]*", "isatty", "readpassphrase", "RPP_*", "winsize", "TIOC*", "ECHO*", "ICANON", "ISIG", "IEXTEN", "OPOST", "CS[5-8]", "PAR*", "V[A-Z]*", "TCSA*", "TCIFLUSH", "TCOFLUSH", "TCIOFLUSH", "TCOOFF", "TCOON", "TCIOFF", "TCION"]},
    {"id": "pseudo-terminals", "title": "Pseudo terminals", "apue": "19",
     "match": ["posix_openpt", "grantpt", "unlockpt", "ptsname_r", "openpty"]},
    {"id": "time", "title": "Time and clocks",
     "match": ["clock_gettime", "clock_getres", "CLOCK_*", "nanosleep", "mach_absolute_time", "mach_approximate_time", "mach_continuous_time", "mach_continuous_approximate_time", "mach_timebase_info", "gmtime_r", "localtime_r", "mktime", "timegm", "strftime", "tm", "timespec", "timeval", "setitimer", "getitimer", "ITIMER_*", "timerfd_*"]},
    {"id": "memory", "title": "Memory allocation and bytes",
     "match": ["malloc*", "calloc", "realloc", "reallocf", "free", "posix_memalign", "valloc", "pvalloc", "mallinfo2", "mallopt", "M_*", "vm_allocate", "vm_copy", "vm_deallocate", "memchr", "memcmp", "memset_s", "explicit_bzero"]},
    {"id": "randomness", "title": "Randomness",
     "match": ["arc4random", "arc4random_buf", "arc4random_uniform", "getentropy", "getrandom"]},
    {"id": "dynamic-loading", "title": "Dynamic loading",
     "match": ["dlopen", "dlsym", "dlclose", "dlerror", "RTLD_*"]},
    {"id": "c-strings-and-locales", "title": "C strings, characters and locales",
     "match": ["str*", "tolower", "toupper", "setlocale", "newlocale", "freelocale", "LC_*", "locale_t", "isalnum", "isalpha", "isblank", "iscntrl", "isdigit", "isgraph", "islower", "isprint", "ispunct", "isspace", "isupper", "isxdigit"]},
    {"id": "math", "title": "C math",
     "match": ["acos*", "asin*", "atan*", "cbrt*", "cos*", "sin*", "tan*", "exp", "expf", "exp2", "exp2f", "expm1", "expm1f", "log*", "pow*", "hypot*", "erf*", "lgamma*", "tgamma*"]},
    {"id": "darwin", "title": "Darwin's own: Mach, libproc, sysdir, zones",
     "match": ["mach_*", "vm_*", "task_*", "proc_*", "sysdir_*", "malloc_zone_*", "os_unfair_lock_*", "_NSGet*", "kinfo_proc"]}
  ]
}
